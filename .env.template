REGISTRY=ghcr.io
IMAGE_NAME=grader-backend

# The worker's only inputs. Postgres holds the queue, MinIO holds the testcase
# archives; both are reached by container name over the shared grader network.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=

# Concurrent submissions. Above 1 this trades timing fidelity for throughput
# and wants one pinned physical core per lane (DESIGN.md section 4).
LANES=1
